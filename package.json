{
  "name": "dsh-conversation-split",
  "version": "0.1.0",
  "description": "Antigravity-style split view for DeepSeek Harness Desktop: several conversations side by side (or stacked) in one window. macOS + Windows.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "esbuild": "^0.25.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/locke-w/dsh-conversation-split.git"
  },
  "homepage": "https://github.com/locke-w/dsh-conversation-split#readme",
  "bugs": {
    "url": "https://github.com/locke-w/dsh-conversation-split/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "split-view",
    "antigravity"
  ]
}
